
import pygame
from pygame.locals import K_UP, K_DOWN, K_LEFT, K_RIGHT, KEYDOWN, QUIT, K_LSHIFT
import random
playermass = 50
def game():
    pygame.init()
    window = pygame.display.set_mode((500, 500))
    pygame.display.set_caption('thing')


    counter, text = 5, '5'.rjust(3)
    pygame.time.set_timer(pygame.USEREVENT, 1000)
    font = pygame.font.SysFont('Consolas', 30)

    class Player(pygame.sprite.Sprite):
        def __init__(self, x, y, mass):
            super().__init__()
            self.image = pygame.transform.scale(pygame.image.load('secco.png'), (mass, mass))
            self.rect = self.image.get_rect()
            self.rect.topleft = (x,y)
            self.accel = 2
            self.maxspeed = 20
            self.friction = 0.9
            self.speedX = 0
            self.speedY = 0
            self.mass = mass

        def update(self, keys_pressed, mass):
            if keys_pressed[K_LEFT] and self.rect.left > 0:
                self.speedX -= self.accel
                self.image = pygame.transform.scale(pygame.image.load('secco.png'), (mass, mass))
        
            if keys_pressed[K_RIGHT] and self.rect.right < 500:
                self.speedX += self.accel
                self.image = pygame.transform.scale(pygame.image.load('secco.png'), (mass, mass))
            
            if keys_pressed[K_UP] and self.rect.top > 0:
                self.speedY-= self.accel
                self.image = pygame.transform.scale(pygame.image.load('secco.png'), (mass, mass))
                
            if keys_pressed[K_DOWN] and self.rect.bottom < 500:
                self.speedY += self.accel
                self.image = pygame.transform.scale(pygame.image.load('secco.png'), (mass, mass))

            self.speedX *= self.friction
            self.speedY *= self.friction

            if self.speedX > self.maxspeed:
                self.speedX = self.maxspeed
            elif self.speedX < -self.maxspeed:
                self.speedX = -self.maxspeed

            self.rect.x += self.speedX
            self.rect.y += self.speedY

            self.rect.width = mass
            self.rect.height = mass

    class Enemy(pygame.sprite.Sprite):
        def __init__(self, x, y, mass):
            super().__init__()
            self.mass = mass
            self.image = pygame.transform.scale(pygame.image.load('secco.png'), (mass, mass))
            self.rect = self.image.get_rect()
            self.rect.topleft = (x, y)

        def reset_pos(self):
            self.rect.y = random.randrange(0, 600)
            self.rect.x = -20

        def Update(self):
            self.rect.x += 2
            if self.rect.x > 610:
                self.reset_pos()
            

    all_group = pygame.sprite.Group()
    enemies = pygame.sprite.Group()
    playermass = 50
    player = Player(10, 10, playermass)
    enemy1 = Enemy(300, 300, 100)
    enemy2 = Enemy(100, 400, 10)

    playerAlive = True

    for i in range(10):
        enemy = Enemy(random.randint(0, 500),random.randint(0, 500),random.randint(10, 100) )
        
        all_group.add(enemy)
        enemies.add(enemy)

    all_group.add(enemy1, enemy2, player)
    enemies.add(enemy1, enemy2)

    def colCheck(player, enemies):
        global playermass

        collision_sprites = pygame.sprite.spritecollide(player, enemies, False)
        for sprite in collision_sprites:
            if playermass > sprite.mass:
                
                sprite.reset_pos()
                playermass += sprite.mass*0.1
            else:
                player.image = pygame.transform.scale(pygame.image.load('explosion.png'), (100, 100))
    run = True
    while run:
        pygame.time.delay(10)

        for event in pygame.event.get():
            if event.type == pygame.USEREVENT: 
                counter -= 1
                text = str(counter).rjust(3) if counter > 0 else 'boom!'
            if event.type == pygame.QUIT:
                run = False
                
        if not enemies:
            for i in range(10):
                enemy = Enemy(random.randint(100, 500),random.randint(100, 500),random.randint(10, 50) )
                
                all_group.add(enemy)
                enemies.add(enemy)

        keys_pressed = pygame.key.get_pressed()
        
        player.update(keys_pressed, playermass)
        for enemy in enemies:
            enemy.Update()
        if counter < 1:
            colCheck(player, enemies)

        match playermass:
            case n if n < 400:
                pass
            case n if n > 400:
                counter = 5
                playermass = 50


        window.fill((255,255,255))
        all_group.draw(window) 
        window.blit(font.render(text, True, (0, 0, 0)), (32, 48))

        pygame.display.update()
    pygame.quit()
